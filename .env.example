# Optional external capability credentials. Values are loaded by the CLI without
# overriding variables already exported by the shell.
TAVILY_API_KEY=

# Override this to load a different dotenv file. Do not commit secret-bearing .env files.
# SCAGENT_SDK_ENV_FILE=/absolute/path/to/.env

# --- Pixi compute bootstrap (scripts/bootstrap_compute.sh) ---------------------
# PIXI_MANIFEST=/absolute/path/to/scagent-sdk/pixi.toml
# PIXI_EXEC=/absolute/path/to/pixi
# PIXI_SCAGENT=/absolute/path/to/pixi-storage-root

# --- uv agent bootstrap (scripts/bootstrap_agent.sh) ----------------------------
# UV_EXEC=/absolute/path/to/uv

# --- Model reasoning ("thinking") ---------------------------------------------
# Behavioural defaults live in the model profile's [thinking] table; these
# variables override them for a machine or session, and CLI flags override these.
# Generation:
#   SCAGENT_SDK_THINKING=enabled|disabled|adaptive|native  (on/off also accepted)
#   SCAGENT_SDK_THINKING_BUDGET=8000     # reasoning token budget (>= 1024)
#   SCAGENT_SDK_THINKING_EFFORT=high     # low|medium|high|xhigh|max
#   SCAGENT_SDK_THINKING_DISPLAY=summarized  # summarized|omitted
# Presentation:
#   SCAGENT_SDK_SHOW_THINKING=1          # show reasoning (dimmed) in the terminal
#   SCAGENT_SDK_SAVE_THINKING=1          # persist to <session>/logs/reasoning.log

# --- Upstream model (LiteLLM gateway -> vLLM) ---------------------------------
# The Iris litellm config (configs/litellm/iris-qwen36.yaml) is model-agnostic and
# reads these. Switching models = edit these, then restart the gateway.
# `model` must be openai/<served-name> exactly as vLLM advertises it.
#   SCAGENT_SDK_UPSTREAM_MODEL=openai/Qwen3.8-27B
#   SCAGENT_SDK_FAST_MODEL=openai/Qwen3.8-27B
#   SCAGENT_SDK_UPSTREAM_BASE_URL=http://iscp001:8000/v1
#   SCAGENT_SDK_UPSTREAM_API_KEY=local-noauth
